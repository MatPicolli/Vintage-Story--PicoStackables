<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>PicoStackables</AssemblyName>
    <RootNamespace>PicoStackables</RootNamespace>
    <!-- Keep this in sync with the "version" field in modinfo.json -->
    <Version>1.3.1</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin/$(Configuration)</OutputPath>

    <!--
      VS code mods must NOT ship a .deps.json: the game's mod loader reads it and
      tries to load this assembly a second time when you re-enter a world, throwing
      "Assembly with same name is already loaded". Disable its generation and the
      debug symbols so the build output is just the bare DLL.

      ProduceReferenceAssembly must also be off: the SDK otherwise emits a second
      copy at bin/<Config>/ref/PicoStackables.dll. If the bin folder is deployed
      to Mods, the loader finds both DLLs (same assembly name) and throws the very
      same "Assembly with same name is already loaded" error.
    -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>

    <!--
      Point this to your Vintage Story installation folder.
      Default Steam path:   C:\Program Files (x86)\Steam\steamapps\common\Vintage Story
      Default standalone:   C:\Program Files\Vintagestory
      You can also set VS_INSTALL_DIR as a system environment variable
      and remove the hard-coded fallback below.
    -->
    <VSInstallDir Condition="'$(VSInstallDir)' == ''">D:\Vintagestory</VSInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core API – required -->
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VSInstallDir)\VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Client renderer – needed for IRenderAPI, GuiDialog, Cairo texture helpers -->
    <Reference Include="Vintagestory">
      <HintPath>$(VSInstallDir)\Vintagestory.exe</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Cairo (used in StackableItemCell for ImageSurface / Context) -->
    <Reference Include="cairo-sharp">
      <HintPath>$(VSInstallDir)\Lib\cairo-sharp.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- ProtoBuf (network packets) -->
    <Reference Include="protobuf-net">
      <HintPath>$(VSInstallDir)\Lib\protobuf-net.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    After a Release build, assemble a ModDB-ready zip in releases/ containing
    ONLY modinfo.json + the DLL (+ modicon.png if present). The zip name carries
    the version so successive uploads don't collide.
  -->
  <Target Name="PackageMod" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <StageDir>$(MSBuildProjectDirectory)/obj/modpackage</StageDir>
      <ReleaseDir>$(MSBuildProjectDirectory)/releases</ReleaseDir>
      <ZipPath>$(ReleaseDir)/PicoStackables_v$(Version).zip</ZipPath>
    </PropertyGroup>

    <RemoveDir Directories="$(StageDir)" />
    <MakeDir Directories="$(StageDir);$(ReleaseDir)" />

    <Copy SourceFiles="$(OutputPath)/PicoStackables.dll" DestinationFolder="$(StageDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/modinfo.json" DestinationFolder="$(StageDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/modicon.png" DestinationFolder="$(StageDir)"
          Condition="Exists('$(MSBuildProjectDirectory)/modicon.png')" />

    <Delete Files="$(ZipPath)" Condition="Exists('$(ZipPath)')" />
    <ZipDirectory SourceDirectory="$(StageDir)" DestinationFile="$(ZipPath)" />

    <Message Importance="high" Text="Packaged ModDB zip: $(ZipPath)" />
  </Target>

</Project>
